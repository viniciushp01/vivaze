---
// Logos de clientes. modo "faixa": rolagem contínua em todas as larguras (home).
// modo "grade": grade fixa no desktop e rolagem contínua abaixo de 1024 px (eventos corporativos).
import { Image } from 'astro:assets';
import { clientes } from '../data/site';
import { logo } from '../data/fotos';
interface Props { modo?: 'faixa' | 'grade'; titulo?: string }
const { modo = 'grade', titulo = 'Marcas e instituições que confiaram na gente' } = Astro.props;
---
<div class:list={['logos', modo === 'faixa' ? 'logos--marquee' : 'logos--center']}>
  <p class="vz-caption c-muted">{titulo}</p>
  {modo === 'grade' && (
    <div class="logos-grid logos-grid--5">
      {clientes.map(([arq, nome]) => <Image src={logo(arq)} alt={nome} height={96} width={Math.round((logo(arq).width / logo(arq).height) * 96)} format="webp" loading="lazy" class="logo" />)}
    </div>
  )}
  <div class="marquee-wrap">
    <div class="marquee">
      {[0, 1].map((volta) => clientes.map(([arq, nome]) => <Image src={logo(arq)} alt={volta === 0 ? nome : ''} aria-hidden={volta === 1 ? 'true' : undefined} height={96} width={Math.round((logo(arq).width / logo(arq).height) * 96)} format="webp" loading="lazy" class="logo" />))}
    </div>
  </div>
</div>
